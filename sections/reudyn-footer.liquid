{%- liquid
  assign logo = section.settings.logo
  assign menu = section.settings.menu
  assign copyright = section.settings.copyright_text
  assign tagline = section.settings.tagline_text | default: 'Human, Amplified. Intelligent Wearable Robotics.'
  assign show_copyright = section.settings.show_copyright
  if copyright == blank
    assign year_now = 'now' | date: '%Y'
    assign copyright = 'Copyright © ' | append: year_now | append: ' reudyn.'
  endif

  assign bg_start = section.settings.bg_start | default: '#000000'
  assign bg_end = section.settings.bg_end | default: '#000000'
  assign text_color = section.settings.text_color | default: '#FFFFFF'
  assign muted_color = section.settings.muted_color | default: '#BDBDBD'
  assign line_color = section.settings.line_color | default: '#3A3A3A'
  assign icon_bg = section.settings.icon_bg | default: 'transparent'
  assign icon_color = section.settings.icon_color | default: '#FFFFFF'

  assign pad_t = section.settings.padding_top | default: 64
  assign pad_b = section.settings.padding_bottom | default: 64
  assign pad_x = section.settings.padding_x | default: 95

  assign pad_t_mob = section.settings.padding_top_mob | default: 48
  assign pad_b_mob = section.settings.padding_bottom_mob | default: 40
  assign pad_x_mob = section.settings.padding_x_mob | default: 32
-%}

<div
  class="reudyn-footer"
  data-reudyn-footer
  style="
    --rf-bg-start: {{ bg_start }};
    --rf-bg-end: {{ bg_end }};
    --rf-text: {{ text_color }};
    --rf-muted: {{ muted_color }};
    --rf-line: {{ line_color }};
    --rf-icon-bg: {{ icon_bg }};
    --rf-icon: {{ icon_color }};
    --rf-pt: {{ pad_t }};
    --rf-pb: {{ pad_b }};
    --rf-px: {{ pad_x }};
    --rf-pt-mob: {{ pad_t_mob }};
    --rf-pb-mob: {{ pad_b_mob }};
    --rf-px-mob: {{ pad_x_mob }};
  "
>
  <div class="reudyn-footer__inner">
    <div class="reudyn-footer__top">
      <div class="reudyn-footer__brand">
        <a href="{{ routes.root_url }}" class="reudyn-footer__logo-link">
          {%- if logo != blank -%}
            {{
              logo
              | image_url: width: 400
              | image_tag:
                class: 'reudyn-footer__logo-img',
                widths: '160, 240, 320, 400',
                sizes: 'calc(189 * 100vw / 1440)',
                alt: shop.name,
                loading: 'lazy'
            }}
          {%- elsif settings.logo != blank -%}
            {{
              settings.logo
              | image_url: width: 400
              | image_tag:
                class: 'reudyn-footer__logo-img',
                widths: '160, 240, 320, 400',
                sizes: 'calc(189 * 100vw / 1440)',
                alt: shop.name,
                loading: 'lazy'
            }}
          {%- else -%}
            <span class="reudyn-footer__logo-text">{{ shop.name | upcase }}</span>
          {%- endif -%}
        </a>
        {%- if tagline != blank -%}
          <p class="reudyn-footer__tagline">{{ tagline | escape }}</p>
        {%- endif -%}
      </div>

      <nav class="reudyn-footer__nav" aria-label="Footer">
        {%- if menu != blank -%}
          <ul class="reudyn-footer__menu list-unstyled">
            {%- for link in menu.links -%}
              <li class="reudyn-footer__menu-item">
                <a href="{{ link.url }}" class="reudyn-footer__menu-link">
                  {{- link.title | escape -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- elsif request.design_mode -%}
          <ul class="reudyn-footer__menu list-unstyled">
            <li class="reudyn-footer__menu-item">
              <span class="reudyn-footer__menu-link">Text</span>
            </li>
            <li class="reudyn-footer__menu-item">
              <span class="reudyn-footer__menu-link">Text</span>
            </li>
          </ul>
        {%- endif -%}
      </nav>

      <div class="reudyn-footer__social">
        {% content_for 'blocks' %}
      </div>
    </div>

    {%- if show_copyright -%}
      <p class="reudyn-footer__copyright">{{ copyright | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .reudyn-footer {
    display: block;
    width: 100%;
    box-sizing: border-box;
    min-height: calc(225 * var(--rem));
    background: var(--rf-bg-start);
    color: var(--rf-text);
    padding: calc(var(--rf-pt) * var(--rem)) calc(var(--rf-px) * var(--rem)) calc(var(--rf-pb) * var(--rem));
  }

  @supports (background: linear-gradient(90deg, #000, #000)) {
    .reudyn-footer {
      background: linear-gradient(90deg, var(--rf-bg-start), var(--rf-bg-end));
    }
  }

  .shopify-section.reudyn-footer-section {
    margin: 0;
  }

  .reudyn-footer__inner {
    width: 100%;
    max-width: calc(1440 * var(--rem));
    margin-inline: auto;
  }

  .reudyn-footer__top {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .reudyn-footer__brand {
    flex: 0 0 auto;
    max-width: calc(305 * var(--rem));
  }

  .reudyn-footer__nav {
    flex: 0 0 auto;
    margin-left: calc(309 * var(--rem));
  }

  .reudyn-footer__social {
    flex: 0 0 auto;
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: calc(9 * var(--rem));
  }

  .reudyn-footer__logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  .reudyn-footer__logo-img {
    display: block;
    width: calc(189 * var(--rem));
    height: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .reudyn-footer__tagline {
    margin: calc(8 * var(--rem)) 0 0;
    max-width: calc(305 * var(--rem));
    font-family: var(--font-body-family);
    font-size: calc(12 * var(--rem));
    font-weight: 500;
    line-height: calc(22 * var(--rem));
    color: var(--rf-muted);
  }

  .reudyn-footer__logo-text {
    font-family: var(--font-h2--family);
    font-style: var(--font-h2--style);
    font-weight: 700;
    font-size: calc(28 * var(--rem));
    letter-spacing: 0.08em;
    line-height: 1;
    color: var(--rf-text);
  }

  .reudyn-footer__menu {
    display: flex;
    flex-direction: column;
    gap: calc(13 * var(--rem));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reudyn-footer__nav .reudyn-footer__menu-link {
    font-family: var(--font-body-family);
    font-weight: 500;
    font-size: calc(16 * var(--rem));
    line-height: calc(22 * var(--rem));
    color: var(--rf-text);
    text-decoration: none;
  }

  .reudyn-footer__nav .reudyn-footer__menu-link:hover {
    opacity: 0.7;
  }

  .reudyn-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: calc(53 * var(--rem));
    height: calc(53 * var(--rem));
    border-radius: 50%;
    background: var(--rf-icon-bg);
    color: var(--rf-icon);
    text-decoration: none;
    overflow: hidden;
    transition: opacity 0.2s ease;
  }

  .reudyn-footer__social-link:has(.reudyn-footer__social-img) {
    background: transparent;
  }

  .reudyn-footer__social-link:hover {
    opacity: 0.8;
  }

  .reudyn-footer__social-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .reudyn-footer__social-placeholder {
    font-size: calc(18 * var(--rem));
    line-height: 1;
    color: var(--rf-icon);
    opacity: 0.7;
  }

  .reudyn-footer__social-link--empty {
    opacity: 0.55;
  }

  .reudyn-footer__copyright {
    margin: calc(24 * var(--rem)) 0 0;
    font-family: var(--font-body-family);
    font-weight: 400;
    font-size: calc(12 * var(--rem));
    line-height: calc(22 * var(--rem));
    color: var(--rf-muted);
  }

  @media screen and (min-width: 750px) and (max-width: 768px) {
    .reudyn-footer {
      padding-inline: calc(40 * var(--rem));
    }

    .reudyn-footer__nav {
      margin-left: calc(48 * var(--rem));
    }
  }

  @media screen and (max-width: 749px) {
    .reudyn-footer {
      min-height: 0;
      padding: calc(var(--rf-pt-mob) * var(--rem)) calc(var(--rf-px-mob) * var(--rem)) calc(var(--rf-pb-mob) * var(--rem));
    }

    .reudyn-footer__top {
      flex-direction: column;
      align-items: flex-start;
      gap: calc(36 * var(--rem));
    }

    .reudyn-footer__brand {
      max-width: none;
    }

    .reudyn-footer__nav,
    .reudyn-footer__social {
      margin-left: 0;
    }

    .reudyn-footer__tagline {
      max-width: none;
      font-size: calc(24 * var(--rem));
      line-height: 1.45;
    }

    .reudyn-footer__logo-img {
      width: calc(189 * var(--rem));
    }

    .reudyn-footer__nav .reudyn-footer__menu-link {
      font-size: calc(28 * var(--rem));
      line-height: 1.45;
    }

    .reudyn-footer__menu {
      gap: calc(20 * var(--rem));
    }

    .reudyn-footer__social-link {
      width: calc(72 * var(--rem));
      height: calc(72 * var(--rem));
    }

    .reudyn-footer__social {
      gap: calc(16 * var(--rem));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reudyn footer",
  "tag": "section",
  "class": "reudyn-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Optional. Falls back to theme logo, then shop name."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Select a navigation menu for the center links."
    },
    {
      "type": "text",
      "id": "tagline_text",
      "label": "Tagline",
      "default": "Human, Amplified. Intelligent Wearable Robotics."
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "checkbox",
      "id": "show_copyright",
      "label": "Show copyright line",
      "default": false
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "Copyright © 2026 reudyn."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_start",
      "label": "Background start",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "bg_end",
      "label": "Background end",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Tagline / muted text",
      "default": "#BDBDBD"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Divider",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Social icon background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Placeholder icon color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal",
      "min": 40,
      "max": 280,
      "step": 5,
      "unit": "px",
      "default": 95
    },
    {
      "type": "header",
      "content": "Padding (mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mob",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_x_mob",
      "label": "Horizontal",
      "min": 12,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "reudyn-footer-social"
    }
  ],
  "presets": [
    {
      "name": "Reudyn footer",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}

{%- liquid
  assign document = section.settings.document | default: 'custom'
  assign title = section.settings.title | default: page.title
  assign pad_t = section.settings.padding_top | default: 80
  assign pad_b = section.settings.padding_bottom | default: 80
  assign pad_t_mob = section.settings.padding_top_mob | default: 48
  assign pad_b_mob = section.settings.padding_bottom_mob | default: 48
  assign max_w = section.settings.content_width | default: 960
-%}

<section
  class="policy-doc"
  style="
    --policy-doc-pt: {{ pad_t }};
    --policy-doc-pb: {{ pad_b }};
    --policy-doc-pt-mob: {{ pad_t_mob }};
    --policy-doc-pb-mob: {{ pad_b_mob }};
    --policy-doc-max: {{ max_w }};
  "
>
  <div class="policy-doc__inner">
    {%- if title != blank -%}
      <h1 class="policy-doc__title">{{ title | escape }}</h1>
    {%- endif -%}

    {%- case document -%}
      {%- when 'vulnerability_disclosure' -%}
        {% render 'policy-content-vulnerability-disclosure' %}
      {%- when 'product_security_update' -%}
        {% render 'policy-content-product-security-update' %}
      {%- else -%}
        {%- if page.content != blank -%}
          <div class="policy-doc__body rte">
            {{ page.content }}
          </div>
        {%- elsif section.settings.custom_body != blank -%}
          <div class="policy-doc__body rte">
            {{ section.settings.custom_body }}
          </div>
        {%- endif -%}
    {%- endcase -%}
  </div>
</section>

{% stylesheet %}
  .policy-doc {
    display: block;
    width: 100%;
    box-sizing: border-box;
    background: #fff;
    color: #111;
    padding-top: calc(var(--policy-doc-pt) * var(--rem));
    padding-bottom: calc(var(--policy-doc-pb) * var(--rem));
  }

  .policy-doc__inner {
    width: min(100%, calc(var(--policy-doc-max) * var(--rem)));
    margin: 0 auto;
    padding: 0 calc(80 * var(--rem));
    box-sizing: border-box;
  }

  .policy-doc__title {
    margin: 0 0 calc(32 * var(--rem));
    font-family: var(--font-heading-family);
    font-size: calc(32 * var(--rem));
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: calc(-0.5 * var(--rem));
    color: #111;
    text-align: center;
  }

  .policy-doc__body {
    font-family: var(--font-body-family);
    font-size: calc(16 * var(--rem));
    font-weight: 400;
    line-height: 1.65;
    color: #222;
  }

  .policy-doc__body > *:first-child {
    margin-top: 0;
  }

  .policy-doc__body > *:last-child {
    margin-bottom: 0;
  }

  .policy-doc__body h2 {
    margin: calc(36 * var(--rem)) 0 calc(14 * var(--rem));
    font-family: var(--font-heading-family);
    font-size: calc(22 * var(--rem));
    font-weight: 700;
    line-height: 1.3;
    color: #111;
  }

  .policy-doc__body p {
    margin: 0 0 calc(14 * var(--rem));
  }

  .policy-doc__body ul,
  .policy-doc__body ol {
    margin: 0 0 calc(16 * var(--rem));
    padding-left: calc(22 * var(--rem));
  }

  .policy-doc__body li {
    margin: 0 0 calc(8 * var(--rem));
  }

  .policy-doc__body li:last-child {
    margin-bottom: 0;
  }

  .policy-doc__body a {
    color: #111;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .policy-doc__body a:hover {
    opacity: 0.7;
  }

  .policy-doc__body strong {
    font-weight: 700;
  }

  .policy-doc__table-wrap {
    width: 100%;
    margin: 0 0 calc(24 * var(--rem));
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .policy-doc__table {
    width: 100%;
    min-width: calc(560 * var(--rem));
    border-collapse: collapse;
    font-size: calc(14 * var(--rem));
    line-height: 1.45;
  }

  .policy-doc__caption {
    caption-side: top;
    margin-bottom: calc(10 * var(--rem));
    font-weight: 600;
    text-align: center;
  }

  .policy-doc__table th,
  .policy-doc__table td {
    padding: calc(12 * var(--rem)) calc(14 * var(--rem));
    border: 1px solid #d2d2d2;
    text-align: left;
    vertical-align: top;
  }

  .policy-doc__table th {
    font-weight: 700;
    background: #f7f7f7;
    text-align: center;
    vertical-align: middle;
  }

  .policy-doc__table td {
    text-align: center;
    vertical-align: middle;
  }

  .policy-doc__table tbody tr:nth-child(even) td {
    background: #fafafa;
  }

  @media screen and (max-width: 749px) {
    .policy-doc {
      padding-top: calc(var(--policy-doc-pt-mob) * var(--rem));
      padding-bottom: calc(var(--policy-doc-pb-mob) * var(--rem));
    }

    .policy-doc__inner {
      padding: 0 calc(32 * var(--rem));
    }

    .policy-doc__title {
      font-size: calc(40 * var(--rem));
      margin-bottom: calc(28 * var(--rem));
      text-align: left;
    }

    .policy-doc__body {
      font-size: calc(28 * var(--rem));
      line-height: 1.55;
    }

    .policy-doc__body h2 {
      font-size: calc(32 * var(--rem));
      margin-top: calc(40 * var(--rem));
    }

    .policy-doc__table {
      font-size: calc(24 * var(--rem));
      min-width: calc(640 * var(--rem));
    }

    .policy-doc__table th,
    .policy-doc__table td {
      padding: calc(16 * var(--rem)) calc(18 * var(--rem));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Policy document",
  "tag": "section",
  "class": "policy-document-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "select",
      "id": "document",
      "label": "Document",
      "options": [
        {
          "value": "vulnerability_disclosure",
          "label": "Vulnerability Disclosure Policy"
        },
        {
          "value": "product_security_update",
          "label": "Product Security Update Support"
        },
        {
          "value": "custom",
          "label": "Custom (page content)"
        }
      ],
      "default": "custom"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "info": "Leave blank to use the page title."
    },
    {
      "type": "richtext",
      "id": "custom_body",
      "label": "Custom body",
      "info": "Used only when Document is set to Custom and the page body is empty. Tables are not supported here — use a document preset instead."
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 720,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 960
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mob",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Policy document",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}

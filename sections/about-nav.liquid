<script>
  (function () {
    try {
      var stored = sessionStorage.getItem('reudyn-about-lang');
      if (stored === 'en' || stored === 'zh') {
        document.documentElement.setAttribute('data-about-lang', stored);
      } else if ((document.documentElement.lang || '').toLowerCase().indexOf('zh') !== -1) {
        document.documentElement.setAttribute('data-about-lang', 'zh');
      } else {
        document.documentElement.setAttribute('data-about-lang', 'en');
      }
    } catch (e) {
      document.documentElement.setAttribute('data-about-lang', 'en');
    }
  })();
</script>
<script>
  (function () {
    var posted =
      /(?:^|[?&])customer_posted=true(?:&|$)/.test(window.location.search) ||
      window.location.hash === '#contact_form';
    if (!posted) return;

    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }

    function getScrollRoot() {
      var wrapper = document.querySelector('.page-wrapper');
      if (!wrapper) return document.scrollingElement || document.documentElement;
      var style = window.getComputedStyle(wrapper);
      if (style.overflowY === 'auto' || style.overflowY === 'scroll') return wrapper;
      return document.scrollingElement || document.documentElement;
    }

    function scrollToPostedShell() {
      var shell = document.querySelector('[data-about-subscribe-shell].is-success');
      var nav = document.querySelector('[data-about-nav]');
      if (!shell || !nav) return;

      var root = getScrollRoot();
      var gap = 24;
      var rootTop = root === document.scrollingElement || root === document.documentElement
        ? 0
        : root.getBoundingClientRect().top;
      var currentScroll = root === document.scrollingElement || root === document.documentElement
        ? window.scrollY || document.documentElement.scrollTop
        : root.scrollTop;
      var top = currentScroll + (shell.getBoundingClientRect().top - rootTop) - nav.offsetHeight - gap;

      if (typeof root.scrollTo === 'function') {
        root.scrollTo(0, Math.max(0, top));
      } else {
        window.scrollTo(0, Math.max(0, top));
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', scrollToPostedShell);
    } else {
      scrollToPostedShell();
    }

    window.addEventListener('load', scrollToPostedShell);
  })();
</script>
<script
  src="{{ 'about-page.js' | asset_url }}"
  type="module"
></script>
{{ 'about-subscribe-success.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign logo = section.settings.logo
  assign logo_width = section.settings.logo_width | default: 189
  assign home_url = section.settings.logo_link | default: routes.root_url
  if logo != blank
    assign logo_h = logo_width | times: logo.height | divided_by: logo.width | at_least: 1
    assign logo_w_2x = logo_width | times: 2
    assign logo_w_3x = logo_width | times: 3
    assign logo_widths = logo_width | append: ', ' | append: logo_w_2x | append: ', ' | append: logo_w_3x
    assign logo_sizes = 'calc(' | append: logo_width | append: ' * 100vw / 1440)'
  endif
-%}

<about-nav-component
  class="about-nav"
  data-about-nav
  style="--about-nav-logo-w: {{ logo_width }};"
>
  <div class="about-nav__inner">
    <a class="about-nav__logo" href="{{ home_url }}" aria-label="{{ shop.name | escape }}">
      {%- if logo != blank -%}
        {{
          logo
          | image_url: width: logo_w_2x
          | image_tag:
            class: 'about-nav__logo-img',
            widths: logo_widths,
            sizes: logo_sizes,
            width: logo_width,
            height: logo_h,
            alt: shop.name,
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- else -%}
        <span class="about-nav__logo-text">{{ shop.name | escape }}</span>
      {%- endif -%}
    </a>

    <nav class="about-nav__menu" aria-label="About">
      {%- for block in section.blocks -%}
        {%- if block.type != 'menu_item' -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign label_en = block.settings.label_en
          assign label_zh = block.settings.label_zh | default: label_en
          assign anchor = block.settings.anchor | strip | replace: '#', ''
        -%}
        {%- if label_en == blank and label_zh == blank -%}{%- continue -%}{%- endif -%}
        <a
          class="about-nav__link"
          href="#{{ anchor }}"
          data-about-nav-link
          {{ block.shopify_attributes }}
        >
          <span data-lang-en>{{ label_en | escape }}</span>
          <span data-lang-zh>{{ label_zh | escape }}</span>
        </a>
      {%- endfor -%}
    </nav>

    <div class="about-nav__lang">
      <button
        type="button"
        class="about-nav__lang-button"
        data-about-lang-button
        aria-expanded="false"
        aria-controls="AboutLangPanel-{{ section.id }}"
      >
        <span
          class="about-nav__lang-label"
          data-about-lang-label
          data-label-en="{{ section.settings.lang_label_en | default: 'EN' | escape }}"
          data-label-zh="{{ section.settings.lang_label_zh | default: 'CN' | escape }}"
        >
          {{ section.settings.lang_label_en | default: 'EN' | escape }}
        </span>
        <span class="about-nav__lang-caret" aria-hidden="true">
          {{- 'about-nav-caret.svg' | inline_asset_content -}}
        </span>
      </button>

      <div
        id="AboutLangPanel-{{ section.id }}"
        class="about-nav__lang-panel"
        data-about-lang-panel
        hidden
        role="listbox"
      >
        <button
          type="button"
          class="about-nav__lang-option is-active"
          role="option"
          aria-selected="true"
          data-about-lang-option="en"
        >
          {{ section.settings.lang_label_en | default: 'EN' | escape }}
        </button>
        <button
          type="button"
          class="about-nav__lang-option"
          role="option"
          aria-selected="false"
          data-about-lang-option="zh"
        >
          {{ section.settings.lang_label_zh | default: 'CN' | escape }}
        </button>
      </div>
    </div>
  </div>
</about-nav-component>

{% stylesheet %}
  /* Hide theme header wherever this About nav is present */
  body:has([data-about-nav]) #header-group {
    display: none !important;
  }

  body:has([data-about-nav]) {
    --header-height: 0px;
    --header-group-height: 0px;
  }

  /* EN / ZH content switch (page-wide) */
  html[data-about-lang='en'] [data-lang-zh],
  html:not([data-about-lang]) [data-lang-zh] {
    display: none !important;
  }

  html[data-about-lang='zh'] [data-lang-en] {
    display: none !important;
  }

  .about-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    display: block;
    width: 100%;
    background: #fff;
    border-bottom: 1px solid #e8e8e8;
  }

  .shopify-section:has(.about-nav) {
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .about-nav__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    min-height: calc(82 * var(--rem));
    /* Figma: logo inset 97, lang caret ends 72 from right */
    padding: 0 calc(72 * var(--rem)) 0 calc(97 * var(--rem));
    box-sizing: border-box;
  }

  .about-nav__logo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    max-width: round(calc(var(--about-nav-logo-w) * var(--rem)), 1px);
    text-decoration: none;
    color: #111;
  }

  .about-nav__logo-img {
    display: block;
    /* snap to whole px: rem fractions blur raster logos */
    width: round(calc(var(--about-nav-logo-w) * var(--rem)), 1px);
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  .about-nav__logo-text {
    font-family: var(--font-heading-family);
    font-size: calc(18 * var(--rem));
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .about-nav__menu {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: calc(43 * var(--rem));
  }

  .about-nav__link {
    font-family: var(--font-body-family);
    font-size: calc(12 * var(--rem));
    font-weight: 600;
    line-height: calc(12 * var(--rem));
    color: #989898;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  @media (hover: hover) {
    .about-nav__link:hover {
      color: #111;
    }
  }

  .about-nav__lang {
    position: relative;
    justify-self: end;
  }

  .about-nav__lang-button {
    display: inline-flex;
    align-items: center;
    gap: calc(10 * var(--rem));
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-body-family);
    font-size: calc(14 * var(--rem));
    font-weight: 400;
    line-height: 1;
    color: #616161;
  }

  .about-nav__lang-label {
    display: block;
    flex: 0 0 auto;
    line-height: 1;
    white-space: nowrap;
  }

  .about-nav__lang-caret {
    display: block;
    flex: 0 0 auto;
    width: calc(14 * var(--rem));
    height: calc(7 * var(--rem));
    color: #616161;
    /* Figma: caret center ~0.5px below label center at 1440 */
    transform: translateY(calc(0.5 * var(--rem)));
  }

  .about-nav__lang-caret svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .about-nav__lang-panel {
    position: absolute;
    top: calc(100% + 8 * var(--rem));
    right: 0;
    z-index: 5;
    min-width: calc(88 * var(--rem));
    padding: calc(6 * var(--rem));
    border-radius: calc(4 * var(--rem));
    background: #fff;
    box-shadow: 0 calc(8 * var(--rem)) calc(24 * var(--rem)) rgb(0 0 0 / 0.12);
  }

  .about-nav__lang-option {
    display: flex;
    align-items: center;
    width: 100%;
    margin: 0;
    padding: calc(8 * var(--rem)) calc(10 * var(--rem));
    border: 0;
    border-radius: calc(3 * var(--rem));
    background: transparent;
    cursor: pointer;
    font-family: var(--font-body-family);
    font-size: calc(14 * var(--rem));
    color: #616161;
    text-align: left;
  }

  .about-nav__lang-option.is-active,
  .about-nav__lang-option:hover {
    background: rgb(0 0 0 / 0.04);
    color: #111;
  }

  @media screen and (min-width: 750px) and (max-width: 768px) {
    .about-nav__inner {
      padding: 0 calc(40 * var(--rem));
    }

    .about-nav__menu {
      gap: calc(28 * var(--rem));
    }
  }

  @media screen and (max-width: 749px) {
    .about-nav__inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'logo lang'
        'menu menu';
      gap: calc(32 * var(--rem)) 0;
      min-height: auto;
      padding: calc(20 * var(--rem)) calc(32 * var(--rem));
    }

    .about-nav__logo {
      grid-area: logo;
    }

    .about-nav__logo,
    .about-nav__logo-img {
      max-width: round(calc(var(--about-nav-logo-w) * 1.22 * var(--rem)), 1px);
      width: round(calc(var(--about-nav-logo-w) * 1.22 * var(--rem)), 1px);
    }

    .about-nav__lang-button {
      gap: calc(14 * var(--rem));
      font-size: calc(22 * var(--rem));
    }

    .about-nav__lang-caret {
      width: calc(22 * var(--rem));
      height: calc(11 * var(--rem));
      transform: translateY(calc(0.5 * var(--rem)));
    }

    .about-nav__lang-panel {
      min-width: calc(120 * var(--rem));
      padding: calc(10 * var(--rem));
      border-radius: calc(8 * var(--rem));
    }

    .about-nav__lang-option {
      padding: calc(14 * var(--rem)) calc(16 * var(--rem));
      font-size: calc(22 * var(--rem));
      border-radius: calc(6 * var(--rem));
    }

    .about-nav__lang {
      grid-area: lang;
    }

    .about-nav__menu {
      grid-area: menu;
      justify-self: stretch;
      justify-content: center;
      gap: calc(28 * var(--rem));
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .about-nav__menu::-webkit-scrollbar {
      display: none;
    }

    .about-nav__link {
      font-size: calc(22 * var(--rem));
      line-height: 1.2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About nav",
  "tag": "section",
  "class": "about-nav-section",
  "enabled_on": {
    "templates": ["index", "page"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 120,
      "max": 220,
      "step": 1,
      "unit": "px",
      "default": 189,
      "info": "Design width at 1440px viewport. Scales with --rem."
    },
    {
      "type": "header",
      "content": "Language switcher"
    },
    {
      "type": "text",
      "id": "lang_label_en",
      "label": "English label",
      "default": "EN"
    },
    {
      "type": "text",
      "id": "lang_label_zh",
      "label": "Chinese label",
      "default": "CN"
    }
  ],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Menu item",
      "settings": [
        {
          "type": "text",
          "id": "label_en",
          "label": "Label (EN)",
          "default": "Our story"
        },
        {
          "type": "text",
          "id": "label_zh",
          "label": "Label (ZH)",
          "default": "我们的故事"
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "Scroll target id",
          "default": "about-story",
          "info": "Must match the Anchor id of the target section (without #)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About nav",
      "category": "t:categories.storytelling",
      "blocks": [
        {
          "type": "menu_item",
          "settings": {
            "label_en": "Our story",
            "label_zh": "我们的故事",
            "anchor": "about-story"
          }
        },
        {
          "type": "menu_item",
          "settings": {
            "label_en": "Our mission",
            "label_zh": "我们的使命",
            "anchor": "about-mission"
          }
        },
        {
          "type": "menu_item",
          "settings": {
            "label_en": "Our team",
            "label_zh": "我们的团队",
            "anchor": "about-team"
          }
        }
      ]
    }
  ]
}
{% endschema %}

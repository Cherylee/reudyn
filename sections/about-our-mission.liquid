{%- liquid
  assign max_w = section.settings.content_width | default: 1150
  assign pad_t = section.settings.padding_top | default: 122
  assign pad_b = section.settings.padding_bottom | default: 148
  assign pad_t_mob = section.settings.padding_top_mob | default: 64
  assign pad_b_mob = section.settings.padding_bottom_mob | default: 64
  assign accent = section.settings.accent_color | default: '#F5D421'
  assign anchor = section.settings.anchor_id | default: 'about-mission' | strip | replace: '#', ''
-%}

<section
  id="{{ anchor }}"
  class="about-our-mission"
  data-about-anchor="{{ anchor }}"
  style="
    --about-our-mission-max: {{ max_w }};
    --about-our-mission-pt: {{ pad_t }};
    --about-our-mission-pb: {{ pad_b }};
    --about-our-mission-pt-mob: {{ pad_t_mob }};
    --about-our-mission-pb-mob: {{ pad_b_mob }};
    --about-our-mission-accent: {{ accent }};
  "
>
  <div class="about-our-mission__inner">
    <div class="about-our-mission__header">
      <div class="about-our-mission__side">
        <div class="about-our-mission__label">
          {%- if section.settings.index_label != blank -%}
            <span class="about-our-mission__index">{{ section.settings.index_label | escape }}</span>
          {%- endif -%}
          <span class="about-our-mission__label-text">
            <span data-lang-en>{{ section.settings.label_en | escape }}</span>
            <span data-lang-zh>{{ section.settings.label_zh | default: section.settings.label_en | escape }}</span>
          </span>
        </div>
        <div class="about-our-mission__side-rule" aria-hidden="true"></div>
      </div>

      <div class="about-our-mission__intro">
        {%- if section.settings.heading_en != blank or section.settings.heading_zh != blank -%}
          <h2 class="about-our-mission__heading">
            <span class="rte" data-lang-en>{{ section.settings.heading_en }}</span>
            <span class="rte" data-lang-zh>{{ section.settings.heading_zh | default: section.settings.heading_en }}</span>
          </h2>
        {%- endif -%}

        {%- if section.settings.body_en != blank or section.settings.body_zh != blank -%}
          <div class="about-our-mission__body">
            <div class="rte" data-lang-en>{{ section.settings.body_en }}</div>
            <div class="rte" data-lang-zh>{{ section.settings.body_zh | default: section.settings.body_en }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="about-our-mission__grid">
        {%- for block in section.blocks -%}
          {%- if block.type != 'feature' -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign feature_image = block.settings.image
            assign feature_alt = feature_image.alt | default: block.settings.title_en | default: ''
          -%}
          <article
            class="about-our-mission__card{% if feature_image != blank %} about-our-mission__card--has-bg{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if feature_image != blank -%}
              {{
                feature_image
                | image_url: width: 1200
                | image_tag:
                  class: 'about-our-mission__card-media',
                  widths: '375, 550, 750, 1100, 1200',
                  sizes: '100vw',
                  alt: feature_alt,
                  loading: 'lazy'
              }}
            {%- endif -%}

            {%- if block.settings.number != blank -%}
              <span class="about-our-mission__card-num">{{ block.settings.number | escape }}</span>
            {%- endif -%}

            <div class="about-our-mission__card-foot">
              <strong class="about-our-mission__card-title">
                <span data-lang-en>{{ block.settings.title_en | escape }}</span>
                <span data-lang-zh>{{ block.settings.title_zh | default: block.settings.title_en | escape }}</span>
              </strong>
              <span class="about-our-mission__card-desc">
                <span data-lang-en>{{ block.settings.description_en | escape }}</span>
                <span data-lang-zh>{{ block.settings.description_zh | default: block.settings.description_en | escape }}</span>
              </span>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .about-our-mission {
    display: block;
    width: 100%;
    box-sizing: border-box;
    background: #fff;
    padding-top: calc(var(--about-our-mission-pt) * var(--rem));
    padding-bottom: calc(var(--about-our-mission-pb) * var(--rem));
  }

  .about-our-mission__inner {
    width: min(100%, calc(var(--about-our-mission-max) * var(--rem)));
    margin: 0 auto;
    box-sizing: border-box;
  }

  .about-our-mission__header {
    display: grid;
    grid-template-columns: calc(553 * var(--rem)) calc(552 * var(--rem));
    column-gap: calc(45 * var(--rem));
    align-items: start;
    margin-bottom: calc(99 * var(--rem));
  }

  .about-our-mission__side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(190 * var(--rem));
  }

  .about-our-mission__label {
    display: inline-flex;
    align-items: baseline;
    gap: calc(10 * var(--rem));
    font-family: var(--font-body-family);
    font-size: calc(20 * var(--rem));
    font-weight: 500;
    line-height: calc(20 * var(--rem));
    letter-spacing: calc(-1 * var(--rem));
    text-transform: uppercase;
    color: #000;
  }

  .about-our-mission__index {
    color: var(--about-our-mission-accent);
    font-weight: 500;
  }

  .about-our-mission__side-rule {
    width: calc(4 * var(--rem));
    height: calc(57 * var(--rem));
    background: var(--about-our-mission-accent);
  }

  .about-our-mission__heading {
    margin: 0 0 calc(82 * var(--rem));
    font-family: var(--font-heading-family);
    font-size: calc(68 * var(--rem));
    font-weight: 600;
    line-height: calc(68 * var(--rem));
    letter-spacing: calc(-3.4 * var(--rem));
    color: #000;
  }

  .about-our-mission__heading .rte,
  .about-our-mission__heading p {
    margin: 0;
  }

  .about-our-mission__heading strong,
  .about-our-mission__heading b {
    color: var(--about-our-mission-accent);
    font-weight: inherit;
  }

  .about-our-mission__body {
    max-width: calc(552 * var(--rem));
    font-family: var(--font-body-family);
    font-size: calc(16 * var(--rem));
    font-weight: 500;
    line-height: calc(22 * var(--rem));
    color: #000;
  }

  .about-our-mission__body .rte,
  .about-our-mission__body p {
    margin: 0;
  }

  .about-our-mission__grid {
    display: grid;
    grid-template-columns: calc(385 * var(--rem)) calc(384 * var(--rem)) calc(385 * var(--rem));
  }

  .about-our-mission__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: calc(376 * var(--rem));
    padding: calc(24 * var(--rem)) calc(20 * var(--rem));
    box-sizing: border-box;
    background-color: #fff;
    border: 1px solid #999;
    overflow: hidden;
  }

  .about-our-mission__card--has-bg {
    display: block;
    height: auto;
    min-height: 0;
    padding: 0;
  }

  .about-our-mission__card--has-bg .about-our-mission__card-foot {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    padding: calc(24 * var(--rem)) calc(20 * var(--rem));
    box-sizing: border-box;
  }

  .about-our-mission__card + .about-our-mission__card {
    margin-left: calc(-1 * var(--rem));
  }

  .about-our-mission__card-num {
    position: absolute;
    top: calc(16 * var(--rem));
    left: calc(14 * var(--rem));
    z-index: 1;
    font-family: var(--font-body-family);
    font-size: calc(14 * var(--rem));
    font-weight: 500;
    color: #111;
  }

  .about-our-mission__card-foot {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: calc(12 * var(--rem));
    width: 100%;
  }

  .about-our-mission__card-title {
    font-family: var(--font-heading-family);
    font-size: calc(24 * var(--rem));
    font-weight: 800;
    line-height: calc(20 * var(--rem));
    letter-spacing: calc(-1.2 * var(--rem));
    color: #000;
  }

  .about-our-mission__card-desc {
    font-family: var(--font-body-family);
    font-size: calc(20 * var(--rem));
    font-weight: 400;
    line-height: calc(20 * var(--rem));
    letter-spacing: calc(-1 * var(--rem));
    color: #000;
    text-align: right;
  }

  .about-our-mission__card-media {
    display: block;
    width: 100%;
    height: auto;
    vertical-align: top;
  }

  .about-our-mission__card:not(.about-our-mission__card--has-bg) .about-our-mission__card-media {
    display: none;
  }

  @media screen and (min-width: 750px) and (max-width: 768px) {
    .about-our-mission__inner {
      padding: 0 calc(24 * var(--rem));
    }

    .about-our-mission__header {
      grid-template-columns: 1fr 1.2fr;
      column-gap: calc(28 * var(--rem));
    }

    .about-our-mission__heading {
      font-size: calc(44 * var(--rem));
      line-height: 1.1;
      letter-spacing: calc(-2 * var(--rem));
    }

    .about-our-mission__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .about-our-mission__card:not(.about-our-mission__card--has-bg) {
      height: auto;
      min-height: calc(320 * var(--rem));
    }
  }

  @media screen and (max-width: 749px) {
    .about-our-mission {
      padding-top: calc(var(--about-our-mission-pt-mob) * var(--rem));
      padding-bottom: calc(var(--about-our-mission-pb-mob) * var(--rem));
    }

    .about-our-mission__inner {
      padding: 0 calc(32 * var(--rem));
    }

    .about-our-mission__header {
      grid-template-columns: 1fr;
      gap: calc(28 * var(--rem));
      margin-bottom: calc(40 * var(--rem));
    }

    .about-our-mission__side {
      gap: calc(24 * var(--rem));
    }

    .about-our-mission__heading {
      font-size: calc(68 * var(--rem));
      line-height: 1.1;
      letter-spacing: calc(-2 * var(--rem));
      margin-bottom: calc(28 * var(--rem));
    }

    .about-our-mission__body {
      font-size: calc(28 * var(--rem));
      line-height: 1.45;
    }

    .about-our-mission__grid {
      grid-template-columns: 1fr;
    }

    .about-our-mission__card:not(.about-our-mission__card--has-bg) {
      min-height: calc(376 * var(--rem));
    }

    .about-our-mission__card--has-bg {
      border-color: #d2d2d2;
    }

    .about-our-mission__card + .about-our-mission__card {
      margin-top: calc(-1 * var(--rem));
      margin-left: 0;
    }

    .about-our-mission__card-title {
      font-size: calc(32 * var(--rem));
    }

    .about-our-mission__card-desc {
      font-size: calc(28 * var(--rem));
    }
  }
{% endstylesheet %}

{% schema %}

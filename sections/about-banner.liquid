{%- liquid
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile
  assign image_alt = image.alt | default: section.settings.heading | default: ''
  assign heading = section.settings.heading
  assign radius = section.settings.border_radius | default: 0
  assign radius_mob = section.settings.border_radius_mob | default: radius

  assign pad_t = section.settings.padding_top | default: 0
  assign pad_r = section.settings.padding_right | default: 0
  assign pad_b = section.settings.padding_bottom | default: 0
  assign pad_l = section.settings.padding_left | default: 0

  assign pad_t_mob = section.settings.padding_top_mob | default: 0
  assign pad_r_mob = section.settings.padding_right_mob | default: 0
  assign pad_b_mob = section.settings.padding_bottom_mob | default: 0
  assign pad_l_mob = section.settings.padding_left_mob | default: 0
-%}

<section
  class="about-banner color-{{ section.settings.color_scheme }}"
  data-about-banner
  style="
    --about-banner-radius: {{ radius }};
    --about-banner-radius-mob: {{ radius_mob }};
    --about-banner-pt: {{ pad_t }};
    --about-banner-pr: {{ pad_r }};
    --about-banner-pb: {{ pad_b }};
    --about-banner-pl: {{ pad_l }};
    --about-banner-pt-mob: {{ pad_t_mob }};
    --about-banner-pr-mob: {{ pad_r_mob }};
    --about-banner-pb-mob: {{ pad_b_mob }};
    --about-banner-pl-mob: {{ pad_l_mob }};
    --about-banner-progress: 0;
  "
>
  <div class="about-banner__inner">
    {%- if image != blank -%}
      <picture class="about-banner__picture">
        {%- if image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ image_mobile | image_url: width: 375 }} 375w,
              {{ image_mobile | image_url: width: 550 }} 550w,
              {{ image_mobile | image_url: width: 750 }} 750w,
              {{ image_mobile | image_url: width: 1100 }} 1100w
            "
            sizes="100vw"
            width="{{ image_mobile.width }}"
            height="{{ image_mobile.height }}"
          >
        {%- endif -%}
        {{
          image
          | image_url: width: 3840
          | image_tag:
            class: 'about-banner__img',
            widths: '750, 1100, 1500, 1780, 2000, 2400, 3000, 3840',
            sizes: '100vw',
            alt: image_alt,
            loading: 'eager',
            fetchpriority: 'high'
        }}
      </picture>
    {%- else -%}
      <div class="about-banner__placeholder" aria-hidden="true">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'about-banner__placeholder-svg' }}
      </div>
    {%- endif -%}

    <div class="about-banner__blur" aria-hidden="true"></div>

    {%- if heading != blank -%}
      <div class="about-banner__content">
        <h1 class="about-banner__heading">{{ heading | escape }}</h1>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .about-banner {
    display: block;
    width: 100%;
    position: relative;
    z-index: 1;
    height: calc(100svh - var(--header-group-height, var(--header-height, 0px)));
    max-height: calc(100svh - var(--header-group-height, var(--header-height, 0px)));
    box-sizing: border-box;
    overflow: hidden;
    padding-top: calc(var(--about-banner-pt) * var(--rem));
    padding-right: calc(var(--about-banner-pr) * var(--rem));
    padding-bottom: calc(var(--about-banner-pb) * var(--rem));
    padding-left: calc(var(--about-banner-pl) * var(--rem));
    --about-banner-progress: 0;
  }

  /* Stick the Shopify section shell so content below can scroll over the banner */
  .shopify-section.about-banner-section {
    position: sticky;
    top: var(--header-group-height, var(--header-height, 0px));
    z-index: 1;
  }

  .about-banner__inner {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--about-banner-radius) * var(--rem));
  }

  .about-banner__picture,
  .about-banner__placeholder {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .about-banner__img,
  .about-banner__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  .about-banner__placeholder {
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .about-banner__blur {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    backdrop-filter: blur(calc(var(--about-banner-progress) * 22px));
    -webkit-backdrop-filter: blur(calc(var(--about-banner-progress) * 22px));
    background: transparent;
  }

  /* Text chip only — never a full-bleed box that can stretch layout */
  .about-banner__content {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: block;
    width: max-content;
    max-width: calc(100% - 48 * var(--rem));
    margin: 0;
    padding: 0;
    transform: translate(-50%, -50%);
    pointer-events: none;
    will-change: transform, opacity;
  }

  .about-banner__heading {
    display: block;
    width: max-content;
    max-width: 100%;
    margin: 0;
    padding: 0;
    text-align: center;
    font-family: var(--font-h1--family);
    font-style: var(--font-h1--style);
    font-weight: 700;
    font-size: calc(60 * var(--rem));
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #000;
  }

  @media screen and (min-width: 750px) and (max-width: 768px) {
    .about-banner__heading {
      font-size: calc(48 * var(--rem));
    }
  }

  @media screen and (max-width: 749px) {
    .about-banner {
      padding-top: calc(var(--about-banner-pt-mob) * var(--rem));
      padding-right: calc(var(--about-banner-pr-mob) * var(--rem));
      padding-bottom: calc(var(--about-banner-pb-mob) * var(--rem));
      padding-left: calc(var(--about-banner-pl-mob) * var(--rem));
    }

    .about-banner__inner {
      border-radius: calc(var(--about-banner-radius-mob) * var(--rem));
    }

    .about-banner__heading {
      font-size: calc(40 * var(--rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-banner__content {
      transform: translate(-50%, -50%) !important;
      opacity: 1 !important;
    }

    .about-banner__blur {
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      background: transparent !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About banner",
  "tag": "section",
  "class": "about-banner-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Keeps original aspect ratio; no crop or stretch."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Shown at max-width 749px. Falls back to desktop image if empty."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Human, amplified."
    },
    {
      "type": "header",
      "content": "Corner radius"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Design px × --rem (1440). 0 = square."
    },
    {
      "type": "range",
      "id": "border_radius_mob",
      "label": "Radius (mobile)",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Design px × --rem (750)."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:settings.left",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:settings.right",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding (mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mob",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left_mob",
      "label": "t:settings.left",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_mob",
      "label": "t:settings.right",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "About banner",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}

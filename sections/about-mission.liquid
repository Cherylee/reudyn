<script
  src="{{ 'about-mission.js' | asset_url }}"
  type="module"
></script>

{%- liquid
  assign banner = section.settings.banner_image
  assign banner_mobile = section.settings.banner_image_mobile
  assign banner_alt = banner.alt | default: section.settings.heading | default: ''
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading

  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile
  assign image_alt = image.alt | default: section.settings.title | default: ''

  assign pad_t = section.settings.padding_top | default: 100
  assign pad_b = section.settings.padding_bottom | default: 100

  assign pad_t_mob = section.settings.padding_top_mob | default: 64
  assign pad_r_mob = section.settings.padding_right_mob | default: 32
  assign pad_b_mob = section.settings.padding_bottom_mob | default: 64
  assign pad_l_mob = section.settings.padding_left_mob | default: 32
-%}

<about-mission-component
  class="about-mission"
  data-about-mission
  style="
    --about-mission-pt: {{ pad_t }};
    --about-mission-pb: {{ pad_b }};
    --about-mission-pt-mob: {{ pad_t_mob }};
    --about-mission-pr-mob: {{ pad_r_mob }};
    --about-mission-pb-mob: {{ pad_b_mob }};
    --about-mission-pl-mob: {{ pad_l_mob }};
    --about-banner-progress: 0;
  "
>
  {%- comment -%} Shared sticky hero — sticky ends with this section, before Team {%- endcomment -%}
  <div class="about-mission__stage" data-about-banner>
    <div class="about-mission__stage-inner">
      {%- if banner != blank -%}
        <picture class="about-mission__stage-picture">
          {%- if banner_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ banner_mobile | image_url: width: 375 }} 375w,
                {{ banner_mobile | image_url: width: 550 }} 550w,
                {{ banner_mobile | image_url: width: 750 }} 750w,
                {{ banner_mobile | image_url: width: 1100 }} 1100w
              "
              sizes="100vw"
              width="{{ banner_mobile.width }}"
              height="{{ banner_mobile.height }}"
            >
          {%- endif -%}
          {{
            banner
            | image_url: width: 3840
            | image_tag:
              class: 'about-mission__stage-img',
              widths: '750, 1100, 1500, 1780, 2000, 2400, 3000, 3840',
              sizes: '100vw',
              alt: banner_alt,
              loading: 'eager',
              fetchpriority: 'high'
          }}
        </picture>
      {%- else -%}
        <div class="about-mission__stage-placeholder" aria-hidden="true">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'about-mission__stage-placeholder-svg' }}
        </div>
      {%- endif -%}

      <div class="about-mission__blur" data-about-blur aria-hidden="true"></div>

      {%- if heading != blank or subheading != blank -%}
        <div class="about-mission__intro" data-about-intro>
          {%- if heading != blank -%}
            <h1 class="about-mission__heading">{{ heading | escape }}</h1>
          {%- endif -%}
          {%- if subheading != blank -%}
            <p class="about-mission__subheading">{{ subheading | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="about-mission__panel">
    <div class="about-mission__inner">
      <div class="about-mission__grid">
        <div class="about-mission__col about-mission__col--left">
          {%- if section.settings.title != blank -%}
            <h2 class="about-mission__title about-mission__reveal about-mission__reveal--title">
              {{ section.settings.title | escape }}
            </h2>
          {%- endif -%}

          <div class="about-mission__media about-mission__reveal about-mission__reveal--media">
            {%- if image != blank -%}
              <picture class="about-mission__picture">
                {%- if image_mobile != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ image_mobile | image_url: width: 375 }} 375w,
                      {{ image_mobile | image_url: width: 550 }} 550w,
                      {{ image_mobile | image_url: width: 750 }} 750w,
                      {{ image_mobile | image_url: width: 1100 }} 1100w
                    "
                    sizes="(max-width: 749px) 100vw, calc(220 * 100vw / 1440)"
                    width="{{ image_mobile.width }}"
                    height="{{ image_mobile.height }}"
                  >
                {%- endif -%}
                {{
                  image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'about-mission__img',
                    widths: '220, 440, 598, 750, 1200',
                    sizes: '(max-width: 749px) 100vw, calc(220 * 100vw / 1440)',
                    alt: image_alt,
                    loading: 'lazy',
                    width: 220,
                    height: 220
                }}
              </picture>
            {%- else -%}
              <div class="about-mission__placeholder" aria-hidden="true">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'about-mission__placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
        </div>

        <div class="about-mission__col about-mission__col--right">
          {%- if section.settings.headline != blank -%}
            <div class="about-mission__headline about-mission__reveal about-mission__reveal--title rte">
              {{ section.settings.headline }}
            </div>
          {%- endif -%}

          {%- if section.settings.subtitle != blank -%}
            <div class="about-mission__subtitle about-mission__reveal about-mission__reveal--subtitle rte">
              {{ section.settings.subtitle }}
            </div>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <div class="about-mission__body about-mission__reveal about-mission__reveal--body rte">
              {{ section.settings.body }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</about-mission-component>

{% stylesheet %}
  .about-mission {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    box-sizing: border-box;
    background: transparent;
  }

  .shopify-section.about-mission-section {
    position: relative;
    z-index: 2;
    background: transparent;
  }

  /* Shared sticky hero — unsticks when this section ends (before Team) */
  .about-mission__stage {
    position: sticky;
    top: var(--header-group-height, var(--header-height, 0px));
    z-index: 1;
    width: 100%;
    height: calc(100svh - var(--header-group-height, var(--header-height, 0px)));
    max-height: calc(100svh - var(--header-group-height, var(--header-height, 0px)));
    overflow: hidden;
    --about-banner-progress: 0;
  }

  .about-mission__stage-inner {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .about-mission__stage-picture,
  .about-mission__stage-placeholder {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .about-mission__stage-img,
  .about-mission__stage-placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .about-mission__stage-placeholder {
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .about-mission__blur {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    backdrop-filter: blur(calc(var(--about-banner-progress) * 22px));
    -webkit-backdrop-filter: blur(calc(var(--about-banner-progress) * 22px));
    background: transparent;
  }

  .about-mission__intro {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: max-content;
    max-width: calc(100% - 48 * var(--rem));
    margin: 0;
    padding: 0;
    transform: translate(-50%, -50%);
    pointer-events: none;
    text-align: center;
  }

  .about-mission__heading {
    display: block;
    width: auto;
    max-width: 100%;
    margin: 0;
    padding: 0;
    text-align: center;
    font-family: var(--font-h1--family);
    font-style: var(--font-h1--style);
    font-weight: 700;
    font-size: calc(60 * var(--rem));
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #000;
  }

  .about-mission__subheading {
    display: block;
    width: auto;
    max-width: 100%;
    margin: calc(17 * var(--rem)) 0 0;
    padding: 0;
    text-align: center;
    font-family: var(--font-paragraph--family);
    font-style: var(--font-paragraph--style);
    font-weight: 400;
    font-size: calc(22 * var(--rem));
    line-height: calc(24 * var(--rem));
    color: #303030;
  }

  /* Mission copy scrolls over the shared sticky stage */
  .about-mission__panel {
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    width: 100%;
    min-height: 85svh;
    padding-top: calc(var(--about-mission-pt) * var(--rem));
    padding-right: calc(241 * var(--rem));
    padding-bottom: calc(var(--about-mission-pb) * var(--rem));
    padding-left: calc(241 * var(--rem));
    background: transparent;
  }

  .about-mission__inner {
    position: sticky;
    top: 48vh;
    width: 100%;
    margin-inline: auto;
  }

  .about-mission__grid {
    display: grid;
    grid-template-columns: calc(220 * var(--rem)) minmax(0, 1fr);
    gap: calc(77 * var(--rem));
    align-items: start;
  }

  .about-mission__col {
    min-width: 0;
  }

  .about-mission__col--left {
    width: calc(220 * var(--rem));
  }

  .about-mission__title {
    margin: 0 0 calc(109 * var(--rem));
    font-family: var(--font-h2--family);
    font-style: var(--font-h2--style);
    font-weight: 700;
    font-size: calc(40 * var(--rem));
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #000;
  }

  .about-mission__media {
    width: calc(220 * var(--rem));
    height: calc(220 * var(--rem));
  }

  .about-mission__picture,
  .about-mission__placeholder {
    display: block;
    width: calc(220 * var(--rem));
    height: calc(220 * var(--rem));
    margin: 0;
  }

  .about-mission__img,
  .about-mission__placeholder-svg {
    display: block;
    width: calc(220 * var(--rem));
    height: calc(220 * var(--rem));
    max-width: 100%;
    object-fit: contain;
    object-position: center;
  }

  .about-mission__placeholder {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .about-mission__headline {
    margin: 0 0 calc(77 * var(--rem));
    font-family: var(--font-h3--family);
    font-style: var(--font-h3--style);
    font-weight: 700;
    font-size: calc(30 * var(--rem));
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: #000;
  }

  .about-mission__headline p {
    margin: 0;
  }

  .about-mission__headline strong {
    font-weight: 700;
    background-image: linear-gradient(
      transparent 52%,
      #f5d421 52%,
      #f5d421 100%
    );
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding-inline: 0.04em;
  }

  .about-mission__subtitle,
  .about-mission__body {
    font-family: var(--font-paragraph--family);
    font-style: var(--font-paragraph--style);
    font-weight: var(--font-paragraph--weight);
    font-size: calc(16 * var(--rem));
    line-height: 1.65;
    color: #000;
  }

  .about-mission__subtitle {
    margin: 0 0 calc(20 * var(--rem));
  }

  .about-mission__body {
    margin: 0;
  }

  .about-mission__subtitle p,
  .about-mission__body p {
    margin: 0 0 calc(16 * var(--rem));
  }

  .about-mission__subtitle p:last-child,
  .about-mission__body p:last-child {
    margin-bottom: 0;
  }

  .about-mission--js .about-mission__reveal {
    opacity: 0;
    transform: translate3d(0, 56px, 0);
  }

  .about-mission--js.about-mission--settled .about-mission__reveal {
    will-change: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .about-mission--js .about-mission__reveal {
      opacity: 1;
      transform: none;
      will-change: auto;
    }

    .about-mission__intro {
      transform: translate(-50%, -50%) !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    .about-mission__blur {
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 768px) {
    .about-mission__heading {
      font-size: calc(48 * var(--rem));
    }

    .about-mission__grid {
      grid-template-columns: calc(180 * var(--rem)) minmax(0, 1fr);
      gap: calc(40 * var(--rem));
    }

    .about-mission__col--left,
    .about-mission__media,
    .about-mission__picture,
    .about-mission__placeholder,
    .about-mission__img,
    .about-mission__placeholder-svg {
      width: calc(180 * var(--rem));
      height: calc(180 * var(--rem));
    }

    .about-mission__title {
      font-size: calc(32 * var(--rem));
    }

    .about-mission__headline {
      font-size: calc(26 * var(--rem));
    }
  }

  @media screen and (max-width: 749px) {
    .about-mission__blur {
      backdrop-filter: blur(calc(var(--about-banner-progress) * 10px));
      -webkit-backdrop-filter: blur(calc(var(--about-banner-progress) * 10px));
    }

    .about-mission__intro {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      padding-inline: calc(65 * var(--rem));
      align-items: center;
    }

    .about-mission__heading {
      width: calc(373 * var(--rem));
      max-width: 100%;
      font-size: calc(80 * var(--rem));
      line-height: calc(80 * var(--rem));
    }

    .about-mission__subheading {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      align-self: stretch;
      text-align: center;
    }

    .about-mission__panel {
      min-height: 0;
      padding-top: calc(var(--about-mission-pt-mob) * var(--rem));
      padding-right: calc(65 * var(--rem));
      padding-bottom: calc(40 * var(--rem));
      padding-left: calc(65 * var(--rem));
    }

    .about-mission__inner {
      position: relative;
      top: auto;
    }

    .about-mission__grid {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .about-mission__col--left {
      width: auto;
    }

    .about-mission__col--left,
    .about-mission__col--right {
      display: contents;
    }

    .about-mission__title {
      order: 1;
      margin: 0 0 calc(40 * var(--rem));
      font-size: calc(60 * var(--rem));
      line-height: 1.2;
    }

    .about-mission__headline {
      order: 2;
      margin: 0 0 calc(40 * var(--rem));
      font-size: calc(40 * var(--rem));
      line-height: 1.3;
    }

    .about-mission__headline p {
      margin: 0;
    }

    .about-mission__headline p + p {
      margin-top: calc(24 * var(--rem));
    }

    .about-mission__subtitle {
      order: 3;
      margin: 0 0 calc(24 * var(--rem));
      font-size: calc(24 * var(--rem));
      line-height: 1.55;
    }

    .about-mission__body {
      order: 4;
      margin: 0 0 calc(40 * var(--rem));
      font-size: calc(24 * var(--rem));
      line-height: 1.55;
    }

    .about-mission__subtitle p,
    .about-mission__body p {
      margin: 0 0 calc(24 * var(--rem));
      font-size: calc(24 * var(--rem));
    }

    .about-mission__subtitle p:last-child,
    .about-mission__body p:last-child {
      margin-bottom: 0;
    }

    .about-mission__media,
    .about-mission__picture,
    .about-mission__placeholder {
      order: 5;
      width: 100%;
      height: auto;
      max-width: 100%;
      margin-inline: auto;
    }

    .about-mission__img,
    .about-mission__placeholder-svg {
      order: 5;
      display: block;
      width: 100%;
      height: auto;
      max-width: 100%;
      object-fit: contain;
      object-position: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About mission",
  "tag": "section",
  "class": "about-mission-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Hero banner"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image",
      "info": "Shared sticky background for hero + mission."
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Banner image (mobile)",
      "info": "Optional. Shown at max-width 749px."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Human, amplified."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Intelligent support that moves with you."
    },
    {
      "type": "header",
      "content": "Mission — left column"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our Mission"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Displayed at 220×220 (design px × --rem)."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Shown at max-width 749px."
    },
    {
      "type": "header",
      "content": "Mission — right column"
    },
    {
      "type": "richtext",
      "id": "headline",
      "label": "Headline",
      "info": "Use two paragraphs for the mobile gap between lines.",
      "default": "<p>Technology isn't about replacing humans.</p><p>It's about <strong>amplifying</strong> what makes us <strong>human.</strong></p>"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Our curiosity. Our strength. Our freedom to explore. Our ability to become more than we ever imagined.</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>At Reudyn, we pioneer wearable robotics by combining aerospace-grade power systems, adaptive AI, precision robotics, and human-centered design.</p><p>We create technologies that become a natural extension of the human body, amplifying human potential and unlocking new possibilities.</p><p>Technology begins with humanity. It always has. It always will.</p>"
    },
    {
      "type": "header",
      "content": "Mission padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "header",
      "content": "Mission padding (mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_mob",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mob",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_left_mob",
      "label": "t:settings.left",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_right_mob",
      "label": "t:settings.right",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "About mission",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
